# Public env variables for Contact form configuration
# Set this to your Formspree endpoint URL to use Formspree (recommended)
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional EmailJS configuration (used only if CONTACT_ENDPOINT is not set)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Environment flags
NEXT_PUBLIC_NODE_ENV=development
